        <div class="flex items-center justify-between h-16 sm:h-20">
            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-3 group">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-violet-500 via-indigo-500 to-emerald-400 p-0.5 shadow-lg shadow-violet-500/30 group-hover:scale-105 transition-transform duration-300">
