<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-3xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

    <div class="mb-6 flex items-center justify-between">
        <a 
            href="/task/<%= encodeURIComponent(task.filename) %>" 
            class="inline-flex items-center gap-2 text-sm font-bold text-slate-300 hover:text-white px-4 py-2.5 rounded-2xl bg-slate-900 border border-slate-700/80 hover:border-violet-500/50 transition shadow-md"
        >
            <i data-lucide="arrow-left" class="w-4 h-4 text-violet-400"></i>
            <span>Back to Task</span>
        </a>
    </div>

    <div class="bg-slate-900/90 border border-violet-500/25 rounded-3xl p-6 sm:p-8 backdrop-blur-2xl shadow-2xl">
        <div class="mb-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-xs font-bold uppercase tracking-wider mb-2">
                <i data-lucide="edit-3" class="w-3.5 h-3.5 text-emerald-400"></i> Update Task File
            </div>
            <h1 class="text-2xl font-extrabold text-white">
                Edit Task
            </h1>
            <p class="text-xs text-slate-400 mt-1 font-mono">
                Current File: <span class="text-emerald-400 font-semibold"><%= task.filename %></span>
            </p>
        </div>

        <form action="/edit/<%= encodeURIComponent(task.filename) %>" method="POST" class="space-y-6">
            <div>
                <label for="newTitle" class="block text-sm font-semibold text-slate-200 mb-2">
                    Task Title
                </label>
                <input 
                    type="text" 
                    id="newTitle" 
                    name="newTitle" 
                    value="<%= task.title %>" 
                    required 
                    class="w-full px-4 py-3.5 bg-slate-950/70 border border-slate-700/80 rounded-2xl text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition duration-200"
                >
            </div>

            <div>
                <label for="newDescription" class="block text-sm font-semibold text-slate-200 mb-2">
                    Task Content / Description
                </label>
                <textarea 
                    id="newDescription" 
                    name="newDescription" 
                    rows="8" 
                    class="w-full px-4 py-3.5 bg-slate-950/70 border border-slate-700/80 rounded-2xl text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition duration-200 resize-y"
                ><%= task.content %></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <a 
                    href="/task/<%= encodeURIComponent(task.filename) %>" 
                    class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm font-bold transition"
                >
                    Cancel
                </a>
                <button 
                    type="submit" 
                    class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-gradient-to-r from-violet-600 to-emerald-600 hover:from-violet-500 hover:to-emerald-500 text-white font-bold text-sm shadow-lg shadow-violet-600/30 transition cursor-pointer"
                >
                    <i data-lucide="check" class="w-4 h-4"></i>
                    <span>Save Changes</span>
                </button>
            </div>
        </form>
    </div>

</main>

<%- include('partials/footer') %>
